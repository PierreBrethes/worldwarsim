{
  /* This TypeScript project config describes the environment that
   * Convex functions run in and is used to typecheck them.
   * You can modify it, but some settings are required to use Convex.
   */
  "compilerOptions": {
    /* These settings are not required by Convex and can be modified. */
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],

    /* These compiler options are required by Convex */
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"],
  /* Les fichiers de test ne tournent pas sur Convex : ils tournent sous Vitest, et
   * `test.setup.ts` s'y sert de `import.meta.glob`, qui appartient à Vite. Ce projet-ci décrit
   * l'environnement des fonctions serveur — c'est lui que `convex deploy` typecheck — et y faire
   * entrer les types de Vite reviendrait à autoriser un fichier serveur à s'en servir. Ils
   * restent typés par le `tsconfig.json` de la racine, qui inclut `convex` et porte
   * `types: ["vite/client", "node"]` : `npm run types` les couvre, et la CI passe par lui. */
  "exclude": ["./_generated", "./test.setup.ts", "./blitz.fixture.ts", "./**/*.test.ts"]
}
